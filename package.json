{
  "name": "pixel-effect-generator",
  "description": "A growing collection of deterministic pixel-effect generators.",
  "private": true,
  "version": "0.1.0",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "desktop:start": "electron-forge start",
    "desktop:package": "electron-forge package",
    "desktop:make": "electron-forge make && node scripts/desktop-finalize.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/upng-js": "^2.1.5",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "^43.3.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
